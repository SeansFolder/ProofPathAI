# Replace these with unique values before starting. The first super admin is created once.
PROOFPATH_SUPERADMIN_USERNAME=superadmin
PROOFPATH_SUPERADMIN_PASSWORD=replace-with-a-unique-passphrase-at-least-16-characters
PROOFPATH_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional AI services. Leave an endpoint empty to disable that capability.
# Segmentation (SAM 3.1 compatible, typically a Modal GPU endpoint):
# POSTs {"image_base64", "mime_type", "prompt"?}, expects {"masks": [{"label", "score", "bbox": [x,y,w,h], "polygon"?}]}.
PROOFPATH_MODAL_SAM_ENDPOINT=
PROOFPATH_MODAL_TOKEN=
# Report reasoning (Muse Spark compatible, OpenAI-style chat completions):
# POSTs {"model", "messages"}, expects {"choices": [{"message": {"content": "<json>"}}]}.
PROOFPATH_SPARK_ENDPOINT=
PROOFPATH_SPARK_API_KEY=
PROOFPATH_SPARK_MODEL=muse-spark
# Awareness graphics (optional, OpenAI-style image generations):
# POSTs {"prompt", "size", "response_format"}, expects {"data": [{"b64_json" | "url"}]}.
PROOFPATH_IMAGE_ENDPOINT=
PROOFPATH_IMAGE_API_KEY=
