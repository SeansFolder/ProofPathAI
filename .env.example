# Replace these with unique values before starting. The first super admin is created once.
PROOFPATH_SUPERADMIN_USERNAME=superadmin
PROOFPATH_SUPERADMIN_PASSWORD=replace-with-a-unique-passphrase-at-least-16-characters
PROOFPATH_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional development test accounts. The Super Admin is always seeded from the
# settings above. Admin and Resident accounts are only created when the flag is
# enabled (PROOFPATH_SEED_DEMO_ACCOUNTS=1). Creation is idempotent and never
# overwrites an existing account, password, role, or permissions.
# PROOFPATH_ADMIN_USERNAME=demo.admin
# PROOFPATH_ADMIN_PASSWORD=replace-with-a-unique-passphrase-at-least-16-characters
# PROOFPATH_RESIDENT_USERNAME=demo.resident
# PROOFPATH_RESIDENT_PASSWORD=replace-with-a-unique-passphrase-at-least-16-characters
# PROOFPATH_SEED_DEMO_ACCOUNTS=0

# Optional email delivery for resident verification and password recovery.
# When no provider is configured, confirmation links are written to
# data/email_outbox instead of sent (development preview). Configure one
# provider to send real email; failures fall back to the outbox preview.
# PROOFPATH_SMTP_HOST=
# PROOFPATH_SMTP_PORT=587
# PROOFPATH_SMTP_USER=
# PROOFPATH_SMTP_PASSWORD=
# PROOFPATH_SMTP_FROM=ProofPath <no-reply@example.org>
# PROOFPATH_SMTP_TLS=1
# Generic HTTP email API provider (POSTs {"to", "subject", "body"} as JSON):
# PROOFPATH_EMAIL_API_URL=
# PROOFPATH_EMAIL_API_KEY=
# Base URL used to build absolute confirmation links in sent email:
# PROOFPATH_PUBLIC_BASE_URL=http://localhost:8000

# Optional AI services. Leave an endpoint empty to disable that capability.
# Segmentation (SAM 3.1 compatible, typically a Modal GPU endpoint):
# POSTs {"image_base64", "mime_type", "prompt"?}, expects {"masks": [{"label", "score", "bbox": [x,y,w,h], "polygon"?}]}.
PROOFPATH_MODAL_SAM_ENDPOINT=
PROOFPATH_MODAL_TOKEN=
# Report reasoning (Muse Spark compatible, OpenAI-style chat completions):
# POSTs {"model", "messages"}, expects {"choices": [{"message": {"content": "<json>"}}]}.
PROOFPATH_SPARK_ENDPOINT=
PROOFPATH_SPARK_API_KEY=
PROOFPATH_SPARK_MODEL=muse-spark
# Awareness graphics (optional, OpenAI-style image generations):
# POSTs {"prompt", "size", "response_format"}, expects {"data": [{"b64_json" | "url"}]}.
PROOFPATH_IMAGE_ENDPOINT=
PROOFPATH_IMAGE_API_KEY=
